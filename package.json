{
  "name": "2026-blog-app",
  "author": "Catevika Web Dev",
  "description": "Blog with a Markdown Editor, Pexels photos, as well as PDF generation - Frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "coverage:stop": "vitest run --coverage --bail 1",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.0",
